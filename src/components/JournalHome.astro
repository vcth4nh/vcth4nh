---
import type { CollectionEntry } from "astro:content";
import ArrowIcon from "./ArrowIcon.astro";
import BoundarySculpture from "./BoundarySculpture.astro";
import ExhibitionNotes from "./ExhibitionNotes.astro";
import { profile } from "../data/profile";
import "../styles/journal-home.css";

interface Props {
  research: CollectionEntry<"research">[];
  projects: CollectionEntry<"projects">[];
}

const { research, projects } = Astro.props;
const number = (value: number) => String(value).padStart(2, "0");
---
<research-exhibition class="exhibition" id="case-files">
  <div class="exhibit-layout">
    <div class="exhibit-stage">
      <h1 class="exhibit-title" aria-label="Boundary studies">
        <span>Boundary</span>
        <em>studies.</em>
      </h1>
      <span class="exhibit-outline" aria-hidden="true">Boundary</span>
      <div class="exhibit-form">
        <BoundarySculpture />
      </div>
    </div>

    <div class="exhibit-bio">
      <p class="exhibit-author">{profile.name}</p>
      <p>Vulnerability researcher working on authentication, trust boundaries, and AI-assisted security tools.</p>
    </div>

    {research.length > 0 && (
      <>
        <div class="exhibit-index">
          <div class="exhibit-index-label">
            <h2 id="exhibit-index-title">Study index</h2>
            <a href="/research/">Full archive <ArrowIcon size={12} /></a>
          </div>
          <div class="exhibit-tabs" data-study-tabs aria-labelledby="exhibit-index-title">
            {research.map(({ id, data }, index) => (
              <a href={`/research/${id}/`} id={`select-${id}`} data-study-tab data-active={index === 0 ? "true" : undefined}>
                <span class="exhibit-tab-number" aria-hidden="true">{number(index + 1)}</span>
                <span>{data.product ?? data.title}</span>
                <svg class="exhibit-tab-mark" viewBox="0 0 12 12" width="12" height="12" fill="none" aria-hidden="true"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.4"/></svg>
              </a>
            ))}
          </div>
        </div>

        <div class="exhibit-case">
          {research.map(({ id, data }, index) => (
            <article id={`study-${id}`} data-study-panel hidden={index !== 0}>
              <p class="exhibit-case-meta"><span>{number(index + 1)} / {number(research.length)}</span><i aria-hidden="true"></i><time>{data.year}</time></p>
              <h2><a href={`/research/${id}/`}>{data.title}</a></h2>
              <p class="exhibit-credit">{data.roleLabel}</p>
              <a class="exhibit-case-link" href={`/research/${id}/`}>Read case study <ArrowIcon size={14} /></a>
            </article>
          ))}
        </div>
      </>
    )}
  </div>
</research-exhibition>
<ExhibitionNotes {projects} />

<script>
  class ResearchExhibition extends HTMLElement {
    connectedCallback() {
      const tablist = this.querySelector<HTMLElement>("[data-study-tabs]");
      const tabs = Array.from(this.querySelectorAll<HTMLAnchorElement>("[data-study-tab]"));
      const panels = Array.from(this.querySelectorAll<HTMLElement>("[data-study-panel]"));
      if (!tablist || !tabs.length || tabs.length !== panels.length || tablist.hasAttribute("role")) return;
      tablist.setAttribute("role", "tablist");

      const choose = (selected: number, updateUrl = false) => {
        this.dataset.selectedStudy = String(selected);
        if (updateUrl && window.location.hash !== "#" + panels[selected].id) {
          window.history.pushState(window.history.state, "", "#" + panels[selected].id);
        }
        tabs.forEach((tab, index) => {
          const active = index === selected;
          tab.setAttribute("aria-selected", String(active));
          tab.tabIndex = active ? 0 : -1;
          tab.dataset.active = String(active);
          panels[index].hidden = !active;
        });
        window.dispatchEvent(new CustomEvent("research-select", { detail: { index: selected } }));
      };

      tabs.forEach((tab, index) => {
        const panel = panels[index];
        tab.setAttribute("role", "tab");
        tab.setAttribute("aria-controls", panel.id);
        panel.setAttribute("role", "tabpanel");
        panel.setAttribute("aria-labelledby", tab.id);
        tab.addEventListener("click", (event) => {
          if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
          event.preventDefault();
          choose(index, true);
        });
        tab.addEventListener("keydown", (event) => {
          let selected = index;
          switch (event.key) {
            case "ArrowLeft": selected = (index - 1 + tabs.length) % tabs.length; break;
            case "ArrowRight": selected = (index + 1) % tabs.length; break;
            case "Home": selected = 0; break;
            case "End": selected = tabs.length - 1; break;
            case " ": break;
            default: return;
          }
          event.preventDefault();
          choose(selected, true);
          tabs[selected].focus();
        });
      });
      const restore = () => {
        const index = panels.findIndex(panel => "#" + panel.id === window.location.hash);
        choose(Math.max(0, index));
      };
      restore();
      window.addEventListener("hashchange", restore);
    }
  }

  if (!customElements.get("research-exhibition")) {
    customElements.define("research-exhibition", ResearchExhibition);
  }
</script>
