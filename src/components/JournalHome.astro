---
import type { CollectionEntry } from "astro:content";
import { profile, pwn2ownResults } from "../data/profile";
import ProtectedEmail from "./ProtectedEmail.astro";
import ArrowIcon from "./ArrowIcon.astro";
import "../styles/journal-home.css";

interface Props {
  research: CollectionEntry<"research">[];
  projects: CollectionEntry<"projects">[];
}

const { research, projects } = Astro.props;
const activity = profile.latestActivity;
const signalRows = Array.from({ length: 24 }, (_, row) => ({
  offset: 36 + row * 2.55,
  amplitude: 0.8 + row * 0.025,
}));
---
<div class="journal-home">
  <section class="jh-intro jh-shell" aria-labelledby="jh-title">
    <div class="jh-intro-copy">
      <p class="jh-availability"><i aria-hidden="true"></i>Open to collaboration</p>
      <h1 id="jh-title">Vulnerability<br /><em>researcher.</em></h1>
      <p class="jh-introduction">I’m <strong>{profile.name}</strong>. I investigate trust boundaries, build exploits, and develop AI-assisted security tools.</p>
      <div class="jh-actions">
        <a class="jh-button" href="#case-files">Explore research
          <svg width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3v13m-5-5 5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="jh-underlink" href="/resume/">View résumé <ArrowIcon size={14} /></a>
      </div>
    </div>
    <figure class="jh-figure">
      <div class="jh-plate">
        <img src="/images/signal-study.webp" alt="A graphite CRT monitor displays a violet wireframe mountain range." width="1120" height="896" fetchpriority="high" />
        <span aria-hidden="true" class="jh-register jh-register-tl"></span>
        <span aria-hidden="true" class="jh-register jh-register-tr"></span>
        <span aria-hidden="true" class="jh-register jh-register-bl"></span>
        <span aria-hidden="true" class="jh-register jh-register-br"></span>
      </div>
      <figcaption>
        <svg width="23" height="15" viewBox="0 0 23 15" aria-hidden="true" fill="none"><path d="M1 8h4l2-4 3 9 3-12 2.5 9L18 6l1 2h3" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
        <blockquote>{profile.quote}</blockquote>
      </figcaption>
    </figure>
  </section>

  <section class="jh-dispatch latest-activity" aria-labelledby="jh-dispatch-title">
    <div class="jh-shell jh-dispatch-grid">
      <div class="jh-dispatch-date">
        <p><i aria-hidden="true"></i> Latest activity</p>
        <time datetime={activity.date}>{activity.dateLabel}</time>
      </div>
      <div class="jh-dispatch-copy">
        <h2 id="jh-dispatch-title">{activity.title}</h2>
        <p>{activity.summary}</p>
      </div>
      <a class="jh-dispatch-link" href={activity.sourceUrl} target="_blank" rel="noreferrer">ZDI results <ArrowIcon size={16} /></a>
      <svg class="jh-signal" aria-hidden="true" viewBox="0 0 156 105" fill="none" preserveAspectRatio="xMidYMid meet">
        <defs><path id="journal-trace" d="M4 0h32c8 0 13-.4 17-2 5-2 8-4 11-9 2-2 3-1 5-4 3-4 5-12 8-12s4 7 7 10 4 3 7 7 5 4 7 6c5 4 13 4 21 4h30" /></defs>
        {signalRows.map(({ offset, amplitude }) => <use href="#journal-trace" transform={`translate(0 ${offset}) scale(1 ${amplitude})`} />)}
      </svg>
    </div>
  </section>

  <section class="jh-archive jh-shell" id="case-files" aria-labelledby="jh-cases-title">
    <div class="jh-section-head">
      <h2 id="jh-cases-title">Selected research<span>.</span></h2>
      <a class="jh-underlink" href="/research/">Research archive <ArrowIcon size={14} /></a>
    </div>
    <div class="jh-rows">
      {research.map(({ id, data }) => (
        <article>
          <a class="jh-record" href={`/research/${id}/`}>
            <time>{data.year}</time>
            <div class="jh-record-main">
              <h3>{data.title}</h3>
              <p>{data.cves.length ? data.cves.join(" · ") : data.tags.join(" · ")}</p>
            </div>
            <span class="jh-credit">{data.roleLabel}</span>
            <span class="jh-record-link"><ArrowIcon size={19} /></span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="jh-workbench" id="workbench" aria-labelledby="jh-projects-title">
    <div class="jh-shell">
      <div class="jh-section-head">
        <h2 id="jh-projects-title">Open-source tools<span>.</span></h2>
        <a class="jh-underlink" href="/projects/">All projects <ArrowIcon size={14} /></a>
      </div>
      <div class="jh-projects">
        {projects.map(({ data }) => (
          <article class="jh-project">
            <span class="jh-stack">{data.stack.join(" / ")}</span>
            <h3><a href={data.href} target="_blank" rel="noreferrer">{data.title}<ArrowIcon size={24} /></a></h3>
            <p>{data.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="jh-shell jh-background">
    <section class="jh-study" aria-labelledby="jh-study-title">
      <h2 id="jh-study-title">Currently studying</h2>
      <p>{profile.current.title}</p>
      <small>{profile.current.detail}</small>
      <a class="jh-underlink" href="/resume/">Education & experience <ArrowIcon size={14} /></a>
    </section>
    <section class="jh-placements" aria-labelledby="jh-results-title">
      <h2 id="jh-results-title">Pwn2Own Ireland team placements</h2>
      <ol>
        {pwn2ownResults.map((result) => (
          <li><time>{result.year}</time><strong>{result.placement} place</strong><span>{result.team}</span></li>
        ))}
      </ol>
    </section>
  </div>

  <section class="jh-contact" id="contact" aria-labelledby="jh-contact-title">
    <div class="jh-shell jh-contact-inner">
      <h2 id="jh-contact-title">Get in touch<span>.</span></h2>
      <div>
        <p>I’m open to research collaborations, consulting, and full-time roles.</p>
        <ProtectedEmail class="jh-email" />
      </div>
    </div>
  </section>
</div>
