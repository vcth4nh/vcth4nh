---
import type { CollectionEntry } from "astro:content";
import ExhibitionNotes from "./ExhibitionNotes.astro";
import StageMechanism from "./StageMechanism.astro";
import { profile } from "../data/profile";
import "../styles/paper-theatre.css";

interface Props {
  research: CollectionEntry<"research">[];
  projects: CollectionEntry<"projects">[];
}

const { research, projects } = Astro.props;
const sceneArt = {
  "goanywhere-mft": ["first-run", "A cream paper key hangs in front of locked cobalt doors."],
  "authentik-saml-account-takeover": ["reflection", "A paper figure faces a mirror that shows someone else."],
  "ablog-cms": ["passage", "A paper envelope travels through a series of archways."],
  "9router-rce": ["switchboard", "A miniature paper switchboard has an open socket."],
} as const;
const scenes = research.map(entry => {
  const [plate, alt] = sceneArt[entry.id as keyof typeof sceneArt] ?? sceneArt["goanywhere-mft"];
  return { ...entry, plate, alt, product: entry.data.product ?? entry.data.title };
});
const count = (n: number) => String(n).padStart(2, "0");
---

<paper-theatre class="paper-playhouse" id="case-files">
  <section class="playhouse-stage" aria-labelledby="theatre-title">
    <h1 class="sr-only" id="theatre-title">Paper Theatre — vulnerability research by {profile.name}</h1>
    {scenes.map(scene => <span class="scene-anchor" id={`study-${scene.id}`} aria-hidden="true"></span>)}
    <div class="playhouse-set">
      <div class="stage-pictures">
        {scenes.length === 0 && <img src="/theatre/first-run.webp" alt="A cut-paper stage with a suspended key and a locked door." />}
        {scenes.map((scene, i) => (
          <div class="stage-scene" data-stage-scene hidden={i !== 0}>
            <img src={`/theatre/${scene.plate}-set.webp`} class="scene-picture" data-scene-picture
              srcset={`/theatre/${scene.plate}-set-900.webp 900w, /theatre/${scene.plate}-set.webp 1800w`}
              sizes="(max-width: 1600px) 100vw, 1600px" width="1800" height="840"
              alt={scene.alt} fetchpriority={i === 0 ? "high" : "low"} decoding="async" />
            <StageMechanism plate={scene.plate} />
          </div>
        ))}
        <div class="house-curtain" aria-hidden="true">
          <div class="curtain-left" data-curtain-wing></div>
          <div class="curtain-right" data-curtain-wing></div>
        </div>
        <svg class="stage-mask" width="0" height="0" aria-hidden="true" focusable="false">
          <defs>
            <clipPath id="stage-opening" clipPathUnits="objectBoundingBox">
              <path d="M.5 .26 C.46 .26 .446 .292 .416 .274 C.394 .30 .371 .307 .35 .293 C.32 .36 .287 .377 .255 .35 C.22 .405 .196 .389 .175 .382 C.146 .49 .119 .534 .076 .598 C.105 .613 .113 .65 .114 .71 L.10 .975 H.90 L.886 .71 C.887 .65 .895 .613 .924 .598 C.881 .534 .854 .49 .825 .382 C.804 .389 .78 .405 .745 .35 C.713 .377 .68 .36 .65 .293 C.629 .307 .606 .30 .584 .274 C.554 .292 .54 .26 .5 .26 Z" />
            </clipPath>
          </defs>
        </svg>
        <button class="motion-ticket" type="button" data-motion-control hidden>
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
            <path class="motion-pause-icon" d="M3 2h3.5v12H3zm6.5 0H13v12H9.5z" />
            <path class="motion-play-icon" d="M4 2.2 13 8l-9 5.8z" />
          </svg>
          <span data-motion-label>Pause motion</span>
        </button>
      </div>

      {scenes.length > 0 && (
        <div class="stage-apron">
          <div class="stage-caption">
            {scenes.map((scene, i) => (
              <article data-scene-caption data-scene-hash={`study-${scene.id}`} hidden={i !== 0}>
                <span class="stage-number">Scene {count(i + 1)} / {count(scenes.length)}</span>
                <h2><a href={`/research/${scene.id}/`}>
                  {scene.data.title}
                  <svg aria-hidden="true" width="23" height="16" viewBox="0 0 24 16" fill="none"><path d="M1 8h20M15 2l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                </a></h2>
                <span class="stage-product">{scene.product} · {scene.data.year}</span>
              </article>
            ))}
          </div>
          {scenes.length > 1 && <div class="stage-slot" hidden data-pull-slot>
            <button type="button" class="stage-pull" data-scene-pull aria-label="Pull to show the next scene" title="Pull for the next scene">
              Pull <svg width="12" height="13" viewBox="0 0 12 13" aria-hidden="true" fill="none"><path d="M6 1v10M2 7l4 4 4-4" stroke="currentColor" stroke-width="1.5" /></svg>
            </button>
          </div>}
        </div>
      )}
    </div>
    <span class="sr-only" role="status" data-theatre-status></span>
  </section>
  {scenes.length > 1 && (
    <nav class="scene-cues" aria-label="Select a scene">
      <div class="cue-inner">
        <p class="cue-title">Choose a scene</p>
        <div class="cue-tickets">
          {scenes.map((scene, i) => (
            <a href={`/research/${scene.id}/`} data-scene-cue data-scene-href={`#study-${scene.id}`} class="cue-ticket">
              <span class="cue-number">{count(i + 1)}</span>
              <span>{scene.product}</span>
            </a>
          ))}
        </div>
      </div>
    </nav>
  )}
</paper-theatre>

{scenes.length > 0 && (
  <section class="theatre-programme" aria-labelledby="programme-title">
    <div class="programme-inner">
      <div class="programme-intro">
        <h2 id="programme-title">The programme</h2>
        <a href="/research/">Research archive <span aria-hidden="true">↗</span></a>
      </div>
      <ol class="programme-entries">
        {scenes.map((scene, i) => (
          <li><a href={`/research/${scene.id}/`}>
            <span class="programme-count" aria-hidden="true">{count(i + 1)}</span>
            <div>
              <p>{scene.product} <span>· {scene.data.year}</span></p>
              <h3>{scene.data.title}</h3>
              <span class="programme-credit">{scene.data.roleLabel}</span>
            </div>
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M4 3h9v9" stroke="currentColor" stroke-width="1.5"/></svg>
          </a></li>
        ))}
      </ol>
    </div>
  </section>
)}
<ExhibitionNotes {projects} />

<script>
  import "../lib/paper-theatre";
</script>
