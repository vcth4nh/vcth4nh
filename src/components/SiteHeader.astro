---
import { profile } from "../data/profile";
import { primaryNavigation as links } from "../data/navigation";
import PresentationSwitch from "./PresentationSwitch.astro";
import ProtectedEmail from "./ProtectedEmail.astro";
import QuickNavigator from "./QuickNavigator.astro";

const programmeLinks = links.map((link) => ({
  ...link,
  label: link.href === "/projects/" ? "Tools" : link.label,
}));

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isActive = (href: string) => {
  const route = href.replace(/\/+$/, "") || "/";
  return pathname === route || (route !== "/" && pathname.startsWith(`${route}/`));
};
---

<header class="site-header" data-site-header>
  <div class="shell header-inner">
    <a class="wordmark header-wordmark" href="/" aria-label={`${profile.name}, home`}>
      <span class="wordmark-prompt" aria-hidden="true">/</span>{profile.handle}
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map((link, index) => (
        <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
          <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <span>{link.label}</span>
        </a>
      ))}
    </nav>

    <div class="header-tools">
      <PresentationSwitch current="classic" class="classic-presentation-switch" />
      <ProtectedEmail label="Start a conversation" class="header-contact" />
    </div>

    <details class="mobile-nav">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        {links.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))}
        <PresentationSwitch current="classic" class="mobile-presentation-switch" />
        <ProtectedEmail label="Start a conversation" />
      </nav>
    </details>
  </div>

  <div class="journal-header shell">
    <div class="journal-identity">
      <a class="journal-brand" href="/" aria-label={`${profile.name}, home`}>{profile.name}</a>
      <span class="journal-role">{profile.title}</span>
    </div>

    <nav class="journal-nav" aria-label="Primary navigation">
      {programmeLinks.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>{link.label}</a>
      ))}
      <ProtectedEmail label="Contact" keepLabel class="journal-contact" />
    </nav>

    <div class="journal-controls">
      <button class="journal-search" type="button" data-command-trigger aria-haspopup="dialog" aria-label="Search destinations">
        <svg width="18" height="18" aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="8.5" cy="8.5" r="5.3" /><path d="m12.5 12.5 4.3 4.3" /></svg>
        <kbd aria-hidden="true">/</kbd>
      </button>
      <details class="journal-menu">
        <summary aria-label="Navigation menu">
          <svg aria-hidden="true" width="21" height="21" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 6h16M2 13h16" /></svg>
        </summary>
        <nav aria-label="Mobile navigation">
          {programmeLinks.map((link) => (
            <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>{link.label}</a>
          ))}
          <ProtectedEmail label="Contact" keepLabel class="journal-contact" />
        </nav>
      </details>
    </div>
  </div>
</header>

<QuickNavigator />
